# pixi environments
.pixi/*
!.pixi/config.toml

WoWAH/
data/
docs/

.vscode/

*/__pycache__/
__pycache__/
/.quarto/
**/*.quarto_ipynb

**/.DS_Store
# Quarto caches (regenerated on render)
.jupyter_cache/
# _freeze/ is tracked on purpose: the blog post's code cells need the 4 GB raw
# dataset in data/ (git-ignored), so the frozen results are what lets the
# GitHub Actions workflow render the site without the data.
# Generated reports and plots. The execution report and exploration plots are
# tracked because they are embedded/rendered into the published docs.
/reports/*
!/reports/execution_report/
!/reports/exploration/

# Cached intermediate tables used to redraw the exploration figures
/reports/exploration/cache/

# skrub DataOp cache (see CACHE_DIR in main.py). Regenerated on demand; the
# parse node is expensive so the cache is kept between runs, but it is never
# committed.
.skrub_cache/
